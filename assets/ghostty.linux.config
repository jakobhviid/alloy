# Ghostty config — Linux counterpart of assets/ghostty.mac.config.
# Keep cross-platform settings (colors, palette, padding, cursor, opacity,
# behavior, link, font-feature) in sync with that file. Mac-only keys (macos-*,
# cmd+ keybinds) belong there only; Linux-only keys (font-family, window-theme,
# the GTK/portal notes) belong here only. Split *navigation* is deliberately
# bound on both, with each platform's own modifier — see ── Splits ── below.

# ── Font ─────────────────────────────────────────────────────────────
# UNPATCHED Fira Code, identical to assets/ghostty.mac.config. Deliberately not
# "FiraCode Nerd Font", which is what this used to say: since 1.2.0 Ghostty
# bundles a symbols-only Nerd Font and applies the Nerd Fonts patcher's own
# constraints dynamically to the current cell size, so symbols scale correctly
# whatever the base font is. Upstream's conclusion is that there is no longer a
# reason to use a patched font in Ghostty — and a patched one is actively worse
# here, because its symbol set is frozen at whatever Nerd Fonts release the cask
# shipped while the embedded one tracks Ghostty. It also means this no longer
# leans on the base font being installed for SYMBOLS, only for letterforms;
# `cask "font-fira-code"` is in all four desktop Brewfiles.
#
# Fira Code over JetBrains Mono for the ligature set: ===, !==, -->, ==>, ->,
# =>, <=, >=, &&, || all render, via calt, which is on by default.
#
# The patched font-*-nerd-font casks stay in the Linux Brewfiles regardless —
# Ptyxis is also in use on these boxes and embeds no symbol font, so it still
# needs a real patched face (or font-symbols-only-nerd-font) to render Starship.
font-family = "Fira Code"

# `dlig` is a no-op for Fira Code (its ligatures live in calt), but kept on in
# case the base font is ever swapped to JetBrains Mono — its arrow ligatures
# live in dlig, which Ghostty 1.2.0 turned off by default.
font-feature = dlig

# ── Background transparency + blur ───────────────────────────────────
# background-blur requires a compositor that exposes a blur API
# (KDE/KWin, Hyprland). GNOME/Mutter does NOT — the key is a silent no-op
# on Bazzite until that changes. Opacity still applies. The pre-1.x key
# name was `background-blur-radius`; current canonical is `background-blur`.
# The blur you actually see on the desktops is GNOME compositing it behind the
# window, via Blur my Shell — declared as dconf setkeys in apps/gnome.toml.
# Retune it there; `background-blur` below is kept only for a KWin/Hyprland box.
background-opacity = 0.84
background-blur = 24

# Inactive splits are dimmed so the focused one stands out. Ghostty's default
# (0.7) dims too hard with our translucent background; 0.85 keeps a visible
# difference without the panes going murky.
unfocused-split-opacity = 0.85

# Initial window size in terminal cells (columns × rows). Only affects newly
# created windows, not existing ones, splits, or tabs. GTK note: window
# decorations aren't counted, so the grid may end up a row or two shorter
# than requested when CSD is on — `window-decoration = none` makes it exact.
window-width = 132
window-height = 36

# ── Cursor ───────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
cursor-color = ffffff
cursor-text = 000000

# ── Core colors ──────────────────────────────────────────────────────
background = 15191f
foreground = dcdcdc
selection-background = b3d7ff
selection-foreground = 000000

# Use Ghostty's own background/foreground for the GTK chrome (headerbar,
# tab strip) instead of the system Adwaita theme. Makes the window read
# as one continuous dark surface; still respects window-decoration.
window-theme = ghostty
# Override the titlebar foreground to pure white. Without this, the headerbar
# icons (tab close X, new-tab +, window controls) inherit `foreground = dcdcdc`
# above and read as muted grey against the dark bar. Only takes effect when
# window-theme = ghostty.
window-titlebar-foreground = ffffff

# ── 16-color ANSI palette ────────────────────────────────────────────
palette = 0=#14191e
palette = 1=#eb5032
palette = 2=#3bea06
palette = 3=#c7c400
palette = 4=#3f5bff
palette = 5=#e44dee
palette = 6=#00c5c7
palette = 7=#c7c7c7
palette = 8=#686868
palette = 9=#dd7975
palette = 10=#58e790
palette = 11=#ece100
palette = 12=#a7abf2
palette = 13=#e786f0
palette = 14=#60fdff
palette = 15=#ffffff

# ── Window chrome ────────────────────────────────────────────────────
window-padding-x = 10
# window-padding-y format: "TOP,BOTTOM" — top tightened to 4 to sit closer
# under the titlebar; bottom kept at 8.
window-padding-y = 4,8
window-padding-balance = true
# Ghostty Linux uses GTK CSD with a native titlebar + a tab bar below it
# (gtk-titlebar-style defaults to `native`). The `tabs` style that merges
# tabs into the titlebar was tried and reverted: the resulting bar had no
# draggable area in practice. No equivalent of Mac's macos-titlebar-style
# / proxy-icon needed.

# ── Quick Terminal (quake-style dropdown) ────────────────────────────
# Quick-terminal is implemented in Ghostty on the `wlr-layer-shell`
# Wayland protocol. GNOME's Mutter does NOT expose layer-shell (it's a
# wlroots-ecosystem protocol — Sway, Hyprland, KDE), so Ghostty disables
# the entire feature at runtime on Bazzite with the warning
#   "your compositor does not support the wlr-layer-shell protocol;
#    disabling quick terminal"
# Mac builds use a different code path (NSPanel) and the feature works
# there. On Linux/GNOME the quick-terminal can't be activated until either
# Mutter ships layer-shell support or a stable layer-shell GNOME extension
# exists. We therefore do NOT register a global toggle keybind here —
# doing so just spawns the xdg-desktop-portal permission popup for a
# binding that can never fire, and emits log noise. The settings below
# are kept (harmless no-ops on GNOME) so that the feature lights up the
# moment layer-shell lands, and so the Mac/Linux configs stay aligned.
#
# ── WHERE CTRL+ALT+T LIVES (not in this file) ────────────────────────
# Ctrl+Alt+T = new window is a GNOME custom-keybinding, declared as four
# setkey(dconf) steps in apps/ghostty.toml — NOT a keybind here. The Mac config
# does it in-file with `global:ctrl+alt+t=new_window`; that can't work on Linux,
# because a `global:` keybind needs the GlobalShortcuts portal and Mutter doesn't
# implement it. The GNOME binding is also the better half of the trade: it fires
# whether or not Ghostty is running. Read/verify it on the box with
#   gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings
# and the name/command/binding under .../custom-keybindings/ghostty/.
quick-terminal-position = left
# Width: 1000 px. At Fira Code 12pt (Ghostty's Linux default size), minus
# window-padding-x, that's ~132 columns. Tune to taste:
#   720px ≈ strict half of a 1440-wide laptop
#   1000px ≈ ~58% of 14" laptop (still well under 1/3 of a 3440 ultrawide)
#   1150px ≈ 1/3 of a 3440 ultrawide
quick-terminal-size = 1000px
quick-terminal-animation-duration = 0.2
quick-terminal-screen = mouse
quick-terminal-autohide = true

# ── Bell ─────────────────────────────────────────────────────────────
# Mac counterpart: assets/ghostty.mac.config. Same reason — Claude Code's
# preferredNotifChannel = "terminal_bell" (apps/claude-code.toml) emits a bare
# BEL, and Ghostty's default bell (`no-system,no-audio,attention,title,no-border`)
# is silent, so nothing was heard. Exactly ONE feature diverges from Mac:
#   no-attention → OFF on purpose, and this divergence is the whole point.
#                  `attention` is implemented per-desktop, and upstream's own
#                  docs say that on GNOME "you may receive a notification that,
#                  when clicked, would bring the Ghostty window into focus" —
#                  i.e. precisely the corner banner that pinning Claude Code to
#                  terminal_bell was meant to kill. macOS bounces the dock
#                  instead (a gesture, no banner), so there it stays ON. For
#                  reference: KDE highlights the taskbar icon, Sway colors the
#                  window border, other systems may do nothing at all.
#   system       → hand the bell to the desktop. On GNOME that's the
#                  "Sound > Alert Sound" setting; if no alert sound is set
#                  there the bell stays silent — see the fallback below.
#   title        → kept: 🔔 on the alerted tab's title until refocus.
#   border       → border around the alerted surface until refocus. GTK's
#                  visual-bell equivalent, and it picks up the "which surface
#                  rang" job that no-attention gives up.
#
# VERIFY ON THE BOX (this file is authored from a Mac, and GTK bell routing is
# up to the desktop): `printf '\a'` in an UNFOCUSED surface should ding. If
# `system` turns out silent on GNOME, point the bell at a sound file ALREADY ON
# THE BOX — still nothing audio committed to this repo:
#   bell-features     = audio,title,border,no-attention
#   bell-audio-path   = /usr/share/sounds/freedesktop/stereo/bell.oga
#   bell-audio-volume = 0.4
# No version caveat: the fleet is assumed ≥ 1.3 everywhere, which clears
# bell-features (1.2.0), border-on-GTK (1.2.0) and notify-on-command-finish
# (1.3.0) alike — even though Ghostty here is image-baked, not brew-pinned.
bell-features = system,title,border,no-attention

# Ghostty's own "that took a while" bell — see assets/ghostty.mac.config for the
# full reasoning. `unfocused` so only surfaces you're not watching ring, 30s
# because the 5s default would fire on every `brew upgrade`/`rpm-ostree` run,
# and `bell,no-notify` (the default action, restated) because `notify` would post
# a GNOME banner — the same thing no-attention above is turned off to prevent.
# Rings through bell-features, so on GNOME that's sound + 🔔 + border, no toast.
notify-on-command-finish        = unfocused
notify-on-command-finish-after  = 30s
notify-on-command-finish-action = bell,no-notify

# ── Misc niceties ────────────────────────────────────────────────────
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false

# Auto-allow programs to READ the system clipboard via OSC 52 escape
# sequences (used by neovim/tmux yank-over-SSH, etc.). Default is `ask`,
# which interrupts the flow with a dialog every time. Write is already
# `allow` by default. Mild loosening — any program with stdout can stuff
# requests at your clipboard. Personal-machine appropriate.
clipboard-read = allow

# Click-link to follow: enabled. ctrl+click on URLs (https://, file://, etc.)
# in the terminal opens them in the default app. NOTE: plain folder paths
# like /home/<user>/foo are NOT matched by default — they need a custom
# `link = ...` regex. file:// URIs do work out of the box.
link-url = true
link-previews = true

# ── Keybinds ─────────────────────────────────────────────────────────
# Add ctrl+n for new window (default ctrl+shift+n also still works).
# Trade-off: shadows readline's `down-line-or-history` and ctrl+n in TUIs
# like nano/less. Up-arrow still works for history.
keybind = ctrl+n=new_window

# Add ctrl+w to close just the active surface (the focused tab/split, not
# the whole window of tabs). Default ctrl+shift+w also still works.
# Trade-off: shadows readline's `unix-word-rubout` (ctrl+w = delete previous
# word), which is heavily used in shells. ctrl+backspace still does the same
# thing in most setups. `confirm-close-surface = false` above means this
# closes instantly with no prompt.
keybind = ctrl+w=close_surface

# Add ctrl+v to paste (default ctrl+shift+v also still works).
# Trade-off: shadows readline's `quoted-insert` (ctrl+v lets you literally
# insert the next keypress — used to type a tab char, escape, etc.). Niche,
# easy trade.
keybind = ctrl+v=paste_from_clipboard

# ── Splits ───────────────────────────────────────────────────────────
# Mirror the macOS muscle memory: on Mac, Ghostty ships cmd+d=split-right
# and cmd+shift+d=split-down as built-in defaults. Linux has no cmd key and
# Ghostty's Linux defaults are ctrl+shift+o (right) / ctrl+shift+e (down)
# instead — both are KEPT (this is additive), these just add the Mac layout
# on top so the same fingers work on both platforms.
#
# Trade-off — ctrl+d: this SHADOWS EOF. In a shell/REPL/cat, ctrl+d normally
# sends end-of-input (exit the shell, close python, etc.). Binding it to
# new_split:right means that no longer reaches the program. Use `exit` or
# close the surface (ctrl+w) instead. macOS avoids this clash by using cmd+d;
# on Linux it's a deliberate, accepted trade for the shared muscle memory.
keybind = ctrl+d=new_split:right
keybind = ctrl+shift+d=new_split:down

# Split-focus navigation. Ghostty's Linux default is ctrl+alt+arrows, but
# GNOME/Mutter grabs ctrl+alt+left/right for "switch workspace" (and up/down
# on some layouts) before Ghostty ever sees them, so those are dead inside
# the app. Rebind focus movement to ctrl+super+arrows, which is free across
# every GNOME keybinding schema (super+arrows = tile/maximize, super+shift =
# move-to-monitor, ctrl+alt = workspace — none collide with ctrl+super). This
# also lines up with Ghostty's own super+ctrl+[ ] prev/next-split defaults.
# The ctrl+alt+arrow defaults are left bound (harmless — GNOME eats them).
keybind = ctrl+super+arrow_left=goto_split:left
keybind = ctrl+super+arrow_right=goto_split:right
keybind = ctrl+super+arrow_up=goto_split:up
keybind = ctrl+super+arrow_down=goto_split:down
# alt+shift+arrows added as an easier-to-reach alias. Verified free: GNOME's
# only Alt+Shift+arrow binds (move-to-workspace) all carry an extra Ctrl/Super
# modifier, so plain Alt+Shift+arrow collides with nothing in the WM/shell.
keybind = alt+shift+arrow_left=goto_split:left
keybind = alt+shift+arrow_right=goto_split:right
keybind = alt+shift+arrow_up=goto_split:up
keybind = alt+shift+arrow_down=goto_split:down
# Even out the panes, the Linux counterpart of the Mac config's cmd+shift+e. A
# split always halves the FOCUSED pane, so a second ctrl+d gives 50/25/25 rather
# than thirds; nothing redistributes on create and one keybind can't fire two
# actions, so equalising is its own keystroke.
#
# `ctrl+shift+` is what Cmd is on macOS — the terminal's app namespace, which is why
# ctrl+shift+c/v/t/n/w are the Linux conventions, and a terminal cannot encode it as
# a readline sequence. So ctrl+shift+e is the twin of the Mac config's cmd+shift+e,
# letter for letter. It takes this chord from Ghostty's Linux default of
# new_split:down at no cost: ctrl+shift+d above is declared for that and doesn't
# depend on the default.
#
# Deliberately NOT ctrl+e, the obvious mate for the ctrl+d split: that is
# `end-of-line`, and taking it would strand ctrl+a (beginning-of-line), so the reflex
# would fire on the first half of the pair and die on the second. Unlike ctrl+d's EOF
# or ctrl+w's word-rubout, this one isn't worth the short form.
keybind = ctrl+shift+e=equalize_splits

# The same chord again under the Super (Win) key, because it is the one the fingers
# reach for after using the Mac: Ghostty spells this modifier `super` on Linux and
# `cmd` on macOS, so this line and the Mac config's cmd+shift+e are the same keybind.
# Caveat worth a press on the box: Super is a COMPOSITOR namespace, so a GNOME or
# extension grab on Super+Shift+E would swallow it before Ghostty saw it, silently.
# GNOME's super+shift defaults are the arrow keys (move-to-monitor), not letters, and
# ctrl+shift+e above is unaffected either way.
keybind = super+shift+e=equalize_splits

# super+ctrl+[ ] = prev/next split — kept as defaults.
# Zoom the active split. ctrl+shift+enter is Ghostty's Linux default (kept);
# ctrl+super+enter is added on top so the whole split family shares the
# ctrl+super muscle memory. Both fire toggle_split_zoom.
keybind = ctrl+super+enter=toggle_split_zoom

# ── SSH integration ──────────────────────────────────────────────────
# Ghostty sets TERM=xterm-ghostty, which most remote hosts don't have a
# terminfo entry for — leading to `tput: unknown terminal` errors, broken
# arrow keys, garbled vim/htop, etc. These two flags wrap the `ssh` command
# so Ghostty copies its terminfo to the remote on first connect (ssh-terminfo)
# and forwards a few env vars like COLORTERM (ssh-env). Setting is additive —
# does not disable cursor/title/path defaults.
shell-integration-features = ssh-env,ssh-terminfo

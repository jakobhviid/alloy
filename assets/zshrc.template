# ─── Load once ────────────────────────────────────────────────────────────────
# ~/.zshrc can reach this file by more than one route — the marker block temper
# owns, plus whatever a hand-edited rc already had — and a second pass would
# re-register the plugins, hooks and completions below.
[[ -n ${_ZSHRC_IMAGE_LOADED-} ]] && return
typeset -g _ZSHRC_IMAGE_LOADED=1

# ─── Homebrew ─────────────────────────────────────────────────────────────────
if [[ -d /home/linuxbrew/.linuxbrew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
elif [[ -d /opt/homebrew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi
export HOMEBREW_NO_ENV_HINTS=1

# ─── Locale ───────────────────────────────────────────────────────────────────
# Force a 24-hour clock in locale-aware CLI apps. macOS's "24-hour time" toggle
# is a Cocoa/GUI setting that command-line tools don't read — they use LANG.
# en_US = 12h ("1:29 PM"); en_GB gives 24h ("13:29") while staying English. JS
# runtimes (opencode et al.) only honour LANG/LC_ALL for the default Intl locale,
# not LC_TIME — so this has to be LANG, which also switches dates to DD/MM.
# Accepted trade-off: 24h everywhere.
#
# Guard the export: minimal Linux images (Fedora CoreOS ships only
# C/C.utf8/POSIX, no glibc-langpack) don't generate en_GB.UTF-8, and setting a
# nonexistent LANG makes every subprocess' setlocale() spew "Cannot set LC_* to
# default locale" — so opt in only when it exists, and otherwise keep whatever
# /etc/profile.d/lang.sh settled on (C.UTF-8). macOS always ships the locale, so
# the branch simply always takes there.
if locale -a 2>/dev/null | grep -qix 'en_GB.utf-\?8'; then
    export LANG=en_GB.UTF-8
fi

# ─── Prompt (Starship) ──────────────────────────────────────────────────────
eval "$(starship init zsh)"

# ─── Plugins ──────────────────────────────────────────────────────────────────
# Some distributions package zsh-autosuggestions and zsh-syntax-highlighting
# under /usr/share. Fedora 44 does not, so on Bazzite both arrive from Homebrew
# like everything else — but the loops try the system path first and fall back to
# the brew prefix, which costs nothing and lets this file serve a distro that
# does package them.
#
# The three sourced after them are unguarded on purpose. All three are declared
# in the Brewfile, and the history-substring bindings near the end of this file
# are one of their widgets — so a missing file should be a loud error at startup
# rather than a shell that silently loses its arrow-key history search.
for f in /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh {{ brew_prefix }}/share/zsh-autosuggestions/zsh-autosuggestions.zsh; do
    [[ -r "$f" ]] && source "$f" && break
done
for f in /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh {{ brew_prefix }}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
    [[ -r "$f" ]] && source "$f" && break
done
source {{ brew_prefix }}/share/zsh-history-substring-search/zsh-history-substring-search.zsh
source {{ brew_prefix }}/share/zsh-autopair/autopair.zsh
source {{ brew_prefix }}/share/zsh-you-should-use/you-should-use.plugin.zsh
source {{ brew_prefix }}/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh

# ─── fzf shell integration (Ctrl+R history, Ctrl+T file finder, Alt+C cd) ────
# 2>/dev/null silences fzf's two "(eval):1: can't change option: zle" errors —
# fzf snapshots all shell options with `setopt -o $opt`, which fails on `zle`
# (auto-managed in interactive mode). Harmless but pushes the prompt down by
# 2 rows at startup. See MEMORY.md "fzf --zsh stderr suppression" for context.
source <(fzf --zsh) 2>/dev/null

# ─── fzf previews ────────────────────────────────────────────────────────────
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :200 {} 2>/dev/null || head -200 {}'"
export FZF_ALT_C_OPTS="--preview 'ls -la {}'"

# ─── Completions ──────────────────────────────────────────────────────────────
FPATH={{ brew_prefix }}/share/zsh-completions:{{ brew_prefix }}/share/zsh/site-functions:$FPATH
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ─── History ──────────────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt AUTO_CD
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY

# ─── Podman aliases ──────────────────────────────────────────────────────────
alias pc='podman compose'
alias pcu='podman compose up -d'
alias pcd='podman compose down'
alias pcl='podman compose ps'

# ─── Lazygit alias (lz) ─────────────────────────────────────────────────────
alias lz='lazygit'

# ─── tmux session picker (via sesh) ─────────────────────────────────────────
t() {
  local session
  session=$(sesh list | fzf --no-sort --ansi --prompt '⚡  ' \
    --header '  ^b all ^t tmux ^x zoxide ^d kill ^f find' \
    --bind 'ctrl-b:change-prompt(⚡  )+reload(sesh list)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {})+reload(sesh list)')
  [[ -n "$session" ]] && sesh connect "$session"
}
_sesh_picker_widget() { BUFFER='t'; zle accept-line }
zle -N _sesh_picker_widget
bindkey '^b' _sesh_picker_widget

# ─── eza aliases (modern ls) ─────────────────────────────────────────────────
alias ls='eza --icons --hyperlink --group-directories-first'
alias ll='eza -l --git --icons --hyperlink --group-directories-first --time-style=relative'
alias la='eza -la --git --icons --hyperlink --group-directories-first --time-style=relative'

# ─── SSH-aware terminal background tint ─────────────────────────────────────
# Tints the terminal window subtly (near-black blood red) while ssh is running, resets on the
# next prompt. OSC 11 sets only the color — background-opacity / blur from
# the Ghostty config still apply, so the window stays translucent and blurred,
# just hue-shifted.
#
# Implemented via preexec/precmd hooks rather than an ssh() function wrapper
# because Ghostty's shell-integration (ssh-env,ssh-terminfo features in
# ghostty.config) installs its OWN ssh() function AFTER ~/.zshrc loads, which
# would shadow a function-based wrapper. preexec sees the literal command
# string before execution and is unaffected by which ssh function is on top.
#
# Reset fires on any return to prompt: clean ssh exit, ~. disconnect, network
# drop, remote exit, kill. Close-window doesn't reset (the dying window's
# state doesn't matter — new windows reload the Ghostty config default).
# Other ssh consumers (scp, rsync, git over ssh, ssh-add, sshfs) do not
# trigger the tint because preexec matches "ssh" and "ssh ..." only.
_ssh_tint_preexec() {
  case "$1" in
    ssh|'ssh '*)
      printf '\e]11;#1c0303\a'
      typeset -g _ssh_tinted=1
      ;;
  esac
}
_ssh_tint_precmd() {
  if (( ${_ssh_tinted:-0} )); then
    printf '\e]111\a'
    typeset -g _ssh_tinted=0
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook preexec _ssh_tint_preexec
add-zsh-hook precmd  _ssh_tint_precmd

# ─── Key bindings ─────────────────────────────────────────────────────────────
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# ─── NVM (if installed) ──────────────────────────────────────────────────────
if [[ -d "$HOME/.nvm" ]]; then
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
fi

# ─── Local bins ──────────────────────────────────────────────────────────────
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/.local/npm/bin" ]] && export PATH="$HOME/.local/npm/bin:$PATH"

# ─── Zoxide (smart cd — must be last) ────────────────────────────────────────
export _ZO_DOCTOR=0
eval "$(zoxide init zsh --cmd cd)"

[Unit]
Description=Remove stale Brave Origin profile singleton lock at login
After=default.target

[Service]
Type=oneshot
ExecStart=/usr/bin/rm -f %h/.config/BraveSoftware/Brave-Origin/SingletonLock %h/.config/BraveSoftware/Brave-Origin/SingletonCookie %h/.config/BraveSoftware/Brave-Origin/SingletonSocket

[Install]
WantedBy=default.target
